# Never commit a populated .env file.
# SESSION_SECRET: at least 32 characters. Keep the same value across upgrades.
SESSION_SECRET=
# CREDENTIALS_ENCRYPTION_KEY: exactly 32 bytes, encoded as 64 hex characters or valid base64.
# It must differ from SESSION_SECRET and remain stable: losing or changing it makes encrypted secrets unreadable.
CREDENTIALS_ENCRYPTION_KEY=
# SETUP_TOKEN: required for initial setup, may remain configured afterwards. Never publish its value.
SETUP_TOKEN=
# APP_URL: required in production; exact external URL (for example https://portall.example.com). No trailing slash is needed.
APP_URL=https://example.com
# Set to 1 only when traffic reaches Portall through a trusted reverse proxy.
TRUST_PROXY=1
BASE_PATH=
