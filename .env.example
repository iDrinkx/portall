# Generate values with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit a populated .env file.
SESSION_SECRET=
# 32-byte base64 or 64-character hexadecimal key; distinct from SESSION_SECRET.
# Keep this value stable: changing it without a migration makes stored configuration secrets unreadable.
CREDENTIALS_ENCRYPTION_KEY=
# Required only until setup is complete; generate it with the same command above.
SETUP_TOKEN=
